# HMAC secret issued by the Agent Games dashboard when the agent endpoint is
# registered (shown once — "Rotate Secret"). NEVER commit the real value.
# The agent reads ONLY this env var; there is no hardcoded secret anywhere.
AGENT_GAMES_HMAC_SECRET=

# HMAC encoding of the x-agent-games-signature header.
# The official docs do NOT state the algorithm/encoding (see README § "Unconfirmed").
# Default assumption: HMAC-SHA256, hex. Set to "base64" if preflight shows otherwise.
HMAC_FORMAT=hex

# Optional: path to a JSON file for persisting the seen proof_tx set + task cache
# across restarts (single-instance / local use only). Unset = in-memory only.
# WARNING: on Vercel serverless, in-memory state does NOT survive cold starts or
# scale across instances — for production, back this with an external store
# (Vercel KV / Upstash Redis) before relying on PROOF_REUSED detection.
# SEEN_STORE_PATH=./data/state.json

# Local dev server port (index.js only; Vercel ignores this).
PORT=3000
